{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "json2ts -i ../../packages/report-schema/report.schema.json -o src/lib/report.generated.ts --bannerComment \"/* Generated from packages/report-schema/report.schema.json by npm run gen:types. Do not edit. */\" --additionalProperties false --ignoreMinAndMaxItems"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
